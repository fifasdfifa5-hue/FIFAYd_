-- 4. มองผู้เล่นทุกคน + ชื่อบนหัว (ESP Name & Highlight)
local function ClearESP()
   for _, obj in pairs(ESPHolders) do
      if obj then obj:Destroy() end
   end
   ESPHolders = {}
end

local function CreateESP(player)
   if player == LocalPlayer then return end

   local function AddTag(character)
      if not character then return end
      local head = character:WaitForChild("Head", 5)
      if not head then return end

      local billboard = Instance.new("BillboardGui")
      billboard.Name = "ESP_Name"
      billboard.Adornee = head
      billboard.Size = UDim2.new(0, 100, 0, 30)
      billboard.StudsOffset = Vector3.new(0, 2, 0)
      billboard.AlwaysOnTop = true

      local nameLabel = Instance.new("TextLabel")
      nameLabel.Parent = billboard
      nameLabel.BackgroundTransparency = 1
      nameLabel.Size = UDim2.new(1, 0, 1, 0)
      nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
      nameLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
      nameLabel.TextScaled = true
      nameLabel.Font = Enum.Font.SourceSansBold

      billboard.Parent = head
      table.insert(ESPHolders, billboard)

      local highlight = Instance.new("Highlight")
      highlight.Name = "ESP_Highlight"
      highlight.Adornee = character
      highlight.FillTransparency = 0.5
      highlight.FillColor = Color3.fromRGB(0, 255, 127)
      highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
      highlight.AlwaysOnTop = true
      highlight.Parent = character
      table.insert(ESPHolders, highlight)
   end

   if player.Character then AddTag(player.Character) end
   player.CharacterAdded:Connect(function(char)
      if ESPEnabled then task.wait(0.5); AddTag(char) end
   end)
end

MainTab:CreateToggle({
   Name = "มองผู้เล่นทุกคน (ESP Name)",
   CurrentValue = false,
   Callback = function(Value)
      ESPEnabled = Value
      ClearESP()
      if ESPEnabled then
         for _, player in pairs(Players:GetPlayers()) do
            CreateESP(player)
         end
      end
   end,
})

Players.PlayerAdded:Connect(function(player)
