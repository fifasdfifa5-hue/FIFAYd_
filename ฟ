-- 4. มองผู้เล่นทุกคนแบบไร้ข้อผิดพลาด (Global Reliable ESP)
local function RemoveESPFromChar(char)
   if not char then return end
   if char:FindFirstChild("ESP_Highlight") then char.ESP_Highlight:Destroy() end
   if char:FindFirstChild("Head") and char.Head:FindFirstChild("ESP_Name") then
      char.Head.ESP_Name:Destroy()
   end
end

local function ApplyESPToChar(player, char)
   if player == LocalPlayer or not char then return end
   local head = char:WaitForChild("Head", 3)
   if not head then return end

   -- สร้าง Highlight (เรืองแสงทะลุกำแพง)
   if not char:FindFirstChild("ESP_Highlight") then
      local highlight = Instance.new("Highlight")
      highlight.Name = "ESP_Highlight"
      highlight.Adornee = char
      highlight.FillTransparency = 0.4
      highlight.FillColor = Color3.fromRGB(0, 255, 127)
      highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
      highlight.AlwaysOnTop = true
      highlight.Parent = char
   end

   -- สร้างป้ายชื่อบนหัว
   if not head:FindFirstChild("ESP_Name") then
      local billboard = Instance.new("BillboardGui")
      billboard.Name = "ESP_Name"
      billboard.Adornee = head
      billboard.Size = UDim2.new(0, 150, 0, 35)
      billboard.StudsOffset = Vector3.new(0, 2.5, 0)
      billboard.AlwaysOnTop = true

      local nameLabel = Instance.new("TextLabel")
      nameLabel.Parent = billboard
      nameLabel.BackgroundTransparency = 1
      nameLabel.Size = UDim2.new(1, 0, 1, 0)
      nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
      nameLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
      nameLabel.TextStrokeTransparency = 0
      nameLabel.TextScaled = true
      nameLabel.Font = Enum.Font.SourceSansBold

      billboard.Parent = head
   end
end

-- Loop อัปเดต ESP ทุกๆ 1 วินาที เพื่อให้ครอบคลุมทุกคนในแมพตลอดเวลา
task.spawn(function()
   while true do
      task.wait(1)
      if ESPEnabled then
         for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
               ApplyESPToChar(player, player.Character)
            end
         end
      end
   end
end)

